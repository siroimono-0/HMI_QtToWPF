<UserControl x:Class="HMI_QtToWPF.View.Page.SelectAcountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HMI_QtToWPF.View.Page"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             xmlns:vm="clr-namespace:HMI_QtToWPF.ViewModel"
             
            d:DataContext="{d:DesignInstance Type=vm:SelectAcountVM, IsDesignTimeCreatable=False}"
             
             d:DesignHeight="800" d:DesignWidth="1280"
             Height="800" Width="1280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Style/StyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="Black"/>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="250*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="250*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="250*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="250*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="20,20,20,20"
                Style="{StaticResource BackBtnStyle}"
                    Content="Back"
                    FontSize="70" Foreground="#FF4D4D"
                    Command="{Binding BackClickedCommand}"/>

            <!--<Image Grid.Row="0" Grid.Column="0"
                   Stretch="Uniform">
                <Image.Source>
                    <svg:SvgImage Source="/Images/combo.svg"/>
                </Image.Source>
            </Image>-->


            <Image Grid.Row="0" Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Stretch="Uniform"
                   Margin="0,0,70,0"
                   Source="/Images/combo.png">
            </Image>

            <Button Grid.Row="2" Grid.Column="1"
                    Background="Transparent"
                    Command="{Binding TIMEClickedCommand}"
                    BorderBrush="Transparent">
                <Button.Content>

                    <Border Grid.Row="0" Grid.RowSpan="2"
                    Style="{StaticResource NeonRoundBorder}"
                            Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="370"/>
                                <RowDefinition Height="70"/>
                            </Grid.RowDefinitions>


                            <Image Grid.Row="0" Grid.Column="0"
                   Stretch="Uniform"
                   Source="/Images/time.png">
                            </Image>



                            <TextBlock Grid.Row="1"
                    Text="TIME"
                           FontSize="30"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           >
                            </TextBlock>

                        </Grid>

                    </Border>
                </Button.Content>
            </Button>

            <Button Grid.Row="2" Grid.Column="3"
                    Background="Transparent"
                    Command="{Binding WONClickedCommand}"
                    BorderBrush="Transparent">
                <Button.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="370"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.RowSpan="2"
                    Style="{StaticResource NeonRoundBorder}">
                        </Border>

                        <Image Grid.Row="0" Grid.Column="0"
                   Stretch="Uniform"
                   Source="/Images/won.png">
                        </Image>

                        <TextBlock Grid.Row="1"
                    Text="WON"
                           FontSize="30"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           >
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="15"
                                      Color="#FFFFFF"
                                      ShadowDepth="0"
                                      Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                </Button.Content>
            </Button>

            <Button Grid.Row="2" Grid.Column="5"
                    Background="Transparent"
                    Command="{Binding KwhClickedCommand}"
                    BorderBrush="Transparent">
                <Button.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="370"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.RowSpan="2"
                    Style="{StaticResource NeonRoundBorder}">
                        </Border>

                        <Image Grid.Row="0" Grid.Column="0"
                   Stretch="Uniform"
                   Source="/Images/voltage.png">
                        </Image>


                        <TextBlock Grid.Row="1"
                    Text="Kwh"
                           FontSize="30"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           >
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="15"
                                      Color="#FFFFFF"
                                      ShadowDepth="0"
                                      Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                </Button.Content>
            </Button>

            <Button Grid.Row="2" Grid.Column="7"
                    Background="Transparent"
                    Command="{Binding PERSENTClickedCommand}"
                    BorderBrush="Transparent">
                <Button.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="350"/>
                            <RowDefinition Height="90"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.RowSpan="2"
                    Style="{StaticResource NeonRoundBorder}">
                        </Border>

                        <Image Grid.Row="0" Grid.Column="0"
                   Stretch="Uniform"
                   Source="/Images/battery.png">
                        </Image>

                        <StackPanel Grid.Row="1">

                            <TextBlock 
                    Text="80%"
                           FontSize="30"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           >
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                      Color="#FFFFFF"
                                      ShadowDepth="0"
                                      Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <TextBlock 
                    Text="PERSENT"
                           FontSize="30"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           >
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="15"
                                      Color="#FFFFFF"
                                      ShadowDepth="0"
                                      Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                </Button.Content>
            </Button>

            <TextBlock Grid.Row="4" Grid.Column="3"
                       Grid.ColumnSpan="6"
                       Text="CS : 000 - 0000 - 0000"
                       FontSize="70"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                Style="{StaticResource NeonTextWhiteStyle}"/>

            <Button Grid.Row="0" Grid.Column="7" Grid.ColumnSpan="2"
                    Margin="20,20,20,20"
                Style="{StaticResource HomeBtnStyle}"
                    Content="Home"
                    FontSize="70" Foreground="#3DFFB0"
                    Command="{Binding HomeClicked}"/>


        </Grid>

    </Grid>

</UserControl>
