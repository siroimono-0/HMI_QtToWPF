<UserControl x:Class="HMI_QtToWPF.View.Page.TimeInputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HMI_QtToWPF.View.Page"
             xmlns:module="clr-namespace:HMI_QtToWPF.View.ControlModule"
             mc:Ignorable="d" 
             xmlns:vm="clr-namespace:HMI_QtToWPF.ViewModel"
            d:DataContext="{d:DesignInstance Type=vm:TimeInputVM, IsDesignTimeCreatable=False}"
             d:DesignHeight="800" d:DesignWidth="1280"
             Height="800" Width="1280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Style/StyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="#000000" Panel.ZIndex="-1"/>

        <module:InputBackGround/>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Row="1" Grid.Column="1"
                    Grid.ColumnSpan="4"
                 Text="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="White"
                     FontFamily="DIN"
                     FontSize="100"
                     Margin="50,0,50,0"
                     >


                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border 
                        BorderBrush="#FFFFFF" BorderThickness="3"
                        CornerRadius="15">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="950"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ScrollViewer
                                    Grid.Column="0"
                                    x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                          Padding="0,0,30,0"
                                          Margin="0,0,0,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="Min"
                                           FontSize="50"
                                           FontFamily="DIN"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Grid>
                                                        
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Color="#8FE8FE"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>

                <TextBox.Effect>
                    <DropShadowEffect BlurRadius="5"
                                      Color="#8FE8FE"
                                      ShadowDepth="0"
                                      Opacity="0.8"/>
                </TextBox.Effect>

            </TextBox>

            <module:KeyPad3x3 Grid.Row="3" Grid.Column="3"
                              Grid.RowSpan="2" Grid.ColumnSpan="2"
                              Width="450" Height="450"
                              Margin="100,0,0,0"/>

            <Grid Grid.Row="3" Grid.Column="1"
                  Grid.ColumnSpan="3"
                  Grid.RowSpan="2"
                  Margin="60,0,280,90">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0"
                        Content="10"
                        FontSize="70"
                        Style="{StaticResource LoginKeyPadBtnStyle}"
                        Command="{Binding SimpleBtnClickedCommand}"
                        CommandParameter="10"/>
                <Button Grid.Row="0" Grid.Column="2"
                        Content="20"
                        FontSize="70"
                        Style="{StaticResource LoginKeyPadBtnStyle}"
                        Command="{Binding SimpleBtnClickedCommand}"
                        CommandParameter="20"/>
                <Button Grid.Row="2" Grid.Column="0"
                        Content="30"
                        FontSize="70"
                        Style="{StaticResource LoginKeyPadBtnStyle}"
                        Command="{Binding SimpleBtnClickedCommand}"
                        CommandParameter="30"/>
                <Button Grid.Row="2" Grid.Column="2"
                        Content="40"
                        FontSize="70"
                        Style="{StaticResource LoginKeyPadBtnStyle}"
                        Command="{Binding SimpleBtnClickedCommand}"
                        CommandParameter="40"/>
                <Button Grid.Row="4" Grid.Column="0"
                        Content="50"
                        FontSize="70"
                        Style="{StaticResource LoginKeyPadBtnStyle}"
                        Command="{Binding SimpleBtnClickedCommand}"
                        CommandParameter="50"/>
                <Button Grid.Row="4" Grid.Column="2"
                        Content="60"
                        FontSize="70"
                        Style="{StaticResource LoginKeyPadBtnStyle}"
                        Command="{Binding SimpleBtnClickedCommand}"
                        CommandParameter="60"/>





            </Grid>
        </Grid>

    </Grid>
</UserControl>
