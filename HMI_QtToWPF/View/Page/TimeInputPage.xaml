<UserControl x:Class="HMI_QtToWPF.View.Page.TimeInputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HMI_QtToWPF.View.Page"
             xmlns:module="clr-namespace:HMI_QtToWPF.View.ControlModule"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1280"
             Height="800" Width="1280">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0"
            Background="#000000" Panel.ZIndex="-1"/>
        <!--<controlmodule:KeyPad3x3/>-->

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <module:KeyPad3x3/>
        </Grid>

    </Grid>
</UserControl>
