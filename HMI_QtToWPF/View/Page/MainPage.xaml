<UserControl x:Class="HMI_QtToWPF.View.Page.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HMI_QtToWPF.View.Page"
             xmlns:vm="clr-namespace:HMI_QtToWPF.ViewModel"
             
        d:DataContext="{d:DesignInstance Type=vm:MainVM, IsDesignTimeCreatable=False}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1280">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Style/StyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="Black"/>
        
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="1" Grid.Column="1"
            BorderBrush="#FFFFFF" BorderThickness="5"
                CornerRadius="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      Color="#8FE8FE"
                                      ShadowDepth="0"
                                      Opacity="0.8"/>
                </Border.Effect>
            </Border>

            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                Style="{StaticResource ServerJoinBtnStyle}"
                    Content="Start"
                    Command="{Binding StartClickedCommand}"/>
            </Grid>
            <Button Grid.Row="4" Grid.Column="0"
                    Style="{StaticResource ServerJoinBtnStyle}"
                    Content="Manager"
                    FontSize="30"
                    Command="{Binding ManagerClickedCommand}"/>
        </Grid>
    </Grid>
        
</UserControl>
