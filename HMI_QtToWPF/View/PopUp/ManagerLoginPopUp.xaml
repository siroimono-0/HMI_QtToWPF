<Window x:Class="HMI_QtToWPF.View.PopUp.ManagerLoginPopUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HMI_QtToWPF.View.PopUp"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:HMI_QtToWPF.ViewModel"
        d:DataContext="{d:DesignInstance Type=vm:MainVM, IsDesignTimeCreatable=False}"
        Title="ManagerLoginPopUp" Height="420" Width="640"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/View/Style/StyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="Black"
                Panel.ZIndex="-1"/>
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>


            <!--<TextBox Grid.Row="1" Grid.Column="1"
                 Style="{StaticResource RoundBorderTextBoxStyle}"
                 Text="123123123"/>-->

            <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="White"
                     FontFamily="DIN"
                     FontSize="70">


                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border 
                        BorderBrush="#FFFFFF" BorderThickness="3"
                        CornerRadius="15">

                            <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                          Padding="0,0,30,0"/>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  Color="#8FE8FE"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>

                <TextBox.Effect>
                    <DropShadowEffect BlurRadius="5"
                                      Color="#8FE8FE"
                                      ShadowDepth="0"
                                      Opacity="0.8"/>
                </TextBox.Effect>

            </TextBox>

            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="1" Grid.Column="1"
                    Content="1"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="1"
                    >

                </Button>

                <Button Grid.Row="1" Grid.Column="3"
                    Content="2"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="2">
                </Button>

                <Button Grid.Row="1" Grid.Column="5"
                    Content="3"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="3">
                </Button>

                <Button Grid.Row="1" Grid.Column="7"
                    Content="4"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="4">
                </Button>

                <Button Grid.Row="1" Grid.Column="9"
                    Content="5"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="5">
                </Button>

                <Button Grid.Row="3" Grid.Column="1"
                    Content="6"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="6">
                </Button>

                <Button Grid.Row="3" Grid.Column="3"
                    Content="7"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="7">
                </Button>

                <Button Grid.Row="3" Grid.Column="5"
                    Content="8"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="8">
                </Button>

                <Button Grid.Row="3" Grid.Column="7"
                    Content="9"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="9">
                </Button>

                <Button Grid.Row="3" Grid.Column="9"
                    Content="0"
                    FontSize="80"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="0">
                </Button>

                <Button Grid.Row="1" Grid.Column="11"
                    Content="Delete"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="Delete"
                        FontSize="25">
                </Button>

                <Button Grid.Row="3" Grid.Column="11"
                    Content="Login"
                    Style="{StaticResource LoginKeyPadBtnStyle}"
                    Command="{Binding LoginKeyPadClickedCommand}"
                    CommandParameter="Login"
                        FontSize="30">
                </Button>
            </Grid>

        </Grid>

    </Grid>

</Window>
