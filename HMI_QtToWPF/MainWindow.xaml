<Window x:Class="HMI_QtToWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HMI_QtToWPF.ViewModel"
        xmlns:local="clr-namespace:HMI_QtToWPF"
        xmlns:page="clr-namespace:HMI_QtToWPF.View.Page"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowVM, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1280"
        WindowStyle="None">

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:LoginVM}">
            <page:LoginPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ServerJoinVM}">
            <page:ServerJoinPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainVM}">
            <page:MainPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SelectAcountVM}">
            <page:SelectAcountPage/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TimeInputVM}">
            <page:TimeInputPage/>
        </DataTemplate>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ContentControl
            Grid.Row="1"
            Content="{Binding NavigationService.CurrentPage}"/>
    </Grid>

</Window>
